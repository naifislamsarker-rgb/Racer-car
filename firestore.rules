rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable core primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "naifislamsarker2005@gmail.com";
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Schema Validation Helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt'])
        && data.keys().size() <= 6
        && data.uid is string && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() <= 100
        && data.createdAt is timestamp
        && (!data.keys().contains('highScore') || data.highScore is number)
        && (!data.keys().contains('photoURL') || (data.photoURL is string && data.photoURL.size() <= 1048576));
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['email'])
        && data.keys().size() == 1
        && data.email is string && data.email.size() <= 254;
    }

    function isValidHighScoreEntry(data) {
      return data.keys().hasAll(['uid', 'displayName', 'score', 'timestamp'])
        && data.keys().size() <= 8
        && data.uid is string && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() <= 100
        && data.score is number
        && data.timestamp is timestamp
        && (!data.keys().contains('level') || data.level is number)
        && (!data.keys().contains('mode') || data.mode is string)
        && (!data.keys().contains('photoURL') || (data.photoURL is string && data.photoURL.size() <= 1048576));
    }

    // Resource rules mapping
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().createdAt == existing().createdAt && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'highScore', 'photoURL'])
      );
      
      match /private/info {
        allow get, write: if isOwner(userId);
      }
    }

    match /scores/{scoreId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidHighScoreEntry(incoming()) && incoming().uid == request.auth.uid && incoming().timestamp == request.time;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
